generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  RECEIVED
  LISTED
  SOLD
  AWAITING_ACCEPTANCE
  ACCEPTED
  PAYOUT_DUE
  PAID
  COMPLETED
}

enum Method {
  CASH
  ACH
  CHECK
}

model Customer {
  id                     String        @id @default(cuid())
  name                   String
  email                  String?
  phone                  String?
  phoneE164              String?
  company                String?
  address                String?
  street                 String?
  city                   String?
  state                  String?
  zip                    String?
  addressVerified        Boolean       @default(false)
  addressVerifiedAt      DateTime?
  addressVerifiedSource  String?
  infoToken              String?       @unique
  payoutName             String?
  payoutEmail            String?
  payoutPhone            String?
  payoutAddress          String?
  payoutCity             String?
  payoutState            String?
  payoutZip              String?
  payoutAddressVerified  Boolean       @default(false)
  payoutAddressVerifiedAt DateTime?
  payoutAddressVerifiedSource String?
  checkPayableTo         String?
  bankName               String?
  accountLast4           String?
  payoutReady            Boolean       @default(false)
  payoutUpdatedAt        DateTime?
  smsConsent             Boolean       @default(false)
  smsConsentAt           DateTime?
  smsConsentMethod       String?
  smsOptOut              Boolean       @default(false)
  smsOptOutAt            DateTime?
  consignments           Consignment[]
  messages               SmsMessage[]
  emails                 EmailMessage[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model Consignment {
  id                 String             @id @default(cuid())
  reference          String             @unique
  title              String
  description        String?
  category           String?
  condition          String?
  serialNumber       String?
  location           String?
  notes              String?
  listingUrl         String?
  customerId         String
  customer           Customer           @relation(fields: [customerId], references: [id])
  status             Status             @default(RECEIVED)
  platform           String?
  salePriceCents     Int                @default(0)
  askingPriceCents   Int                @default(0)
  customerPercentBps Int                @default(5000)
  feeCents           Int                @default(0)
  method             Method             @default(CHECK)
  paid               Boolean            @default(false)
  payoutReference    String?
  acceptanceToken    String?            @unique
  acceptedName       String?
  acceptedAt         DateTime?
  acceptedIp         String?
  acceptedUserAgent  String?
  acceptedForwarded  String?
  acceptedCountry    String?
  events             DealEvent[]
  images             ConsignmentImage[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ConsignmentImage {
  id            String      @id @default(cuid())
  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  path          String
  createdAt     DateTime    @default(now())
}

model DealEvent {
  id            String      @id @default(cuid())
  consignmentId String
  consignment   Consignment @relation(fields: [consignmentId], references: [id], onDelete: Cascade)
  kind          String
  summary       String
  ip            String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([consignmentId, createdAt])
}

model Admin {
  id           String   @id @default("staff")
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                        Int     @id @default(1)
  defaultCustomerPercentBps Int     @default(5000)
  brandName                 String  @default("ITNX Consignment")
  legalName                 String  @default("NXRENT LLC")
  contactEmail              String?
  contactPhone              String?
  website                   String?
  address                   String?
  defaultPlatform           String?
  defaultMethod             Method  @default(CHECK)
  payoutNotes               String?
  googleMapsKey             String?
  telnyxApiKey              String?
  telnyxFromNumber          String?
  telnyxMessagingProfileId  String?
  telnyxPublicKey           String?
  smsConsentTemplate        String?
  smsPayoutTemplate         String?
  smsAcceptTemplate         String?
  smtpHost                  String?
  smtpPort                  Int     @default(587)
  smtpSecure                Boolean @default(false)
  smtpUser                  String?
  smtpPass                  String?
  smtpFromName              String?
  smtpFromEmail             String?
  emailPayoutSubject        String?
  emailPayoutHtml           String?
  emailAcceptSubject        String?
  emailAcceptHtml           String?
  emailCustomSubject        String?
  emailCustomHtml           String?
}

model SmsMessage {
  id          String   @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  direction   String
  phone       String
  body        String
  status      String?
  telnyxId    String?  @unique
  createdAt   DateTime @default(now())
}

model EmailMessage {
  id          String    @id @default(cuid())
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  to          String
  subject     String
  body        String
  kind        String?
  status      String?
  error       String?
  createdAt   DateTime  @default(now())
}
